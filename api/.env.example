# ── Database (PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/digitalfred
# Hosted databases (Neon, Supabase) need SSL; local ones usually do not. Auto-detected, override with true/false:
# DATABASE_SSL=true

# ── Auth: generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=30d

# ── Public links & CORS ───────────────────────────────────────────
# Base URL of the page that shows proposals to clients; links are built as {PUBLIC_APP_URL}/p/{token}
PUBLIC_APP_URL=http://localhost:3001
# Production only: comma-separated browser origins allowed to call the API (e.g. a separate frontend)
ALLOWED_ORIGINS=

# ── Scheduler (expires overdue proposals): min 24 chars. Call POST /api/v1/internal/expire-proposals with Bearer <secret>
CRON_SECRET=

# ── Seed script only (npm run seed:admin). Remove from the environment afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
